{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Night-shift repository allowlist",
  "type": "object",
  "required": ["repos"],
  "additionalProperties": false,
  "properties": {
    "repos": {
      "type": "array",
      "description": "The repositories the night shift may work in. An empty list means that no repository is eligible.",
      "items": {
        "type": "object",
        "required": ["name", "maxIssuesPerNight", "testCommand"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "description": "The repository as owner/repo.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,38}/(?!\\.{1,2}$)[A-Za-z0-9._-]{1,100}$"
          },
          "maxIssuesPerNight": {
            "type": "integer",
            "description": "The most issues the runner may pick up from this repository in one night.",
            "minimum": 1
          },
          "testCommand": {
            "type": "string",
            "description": "The command that runs the repository's tests.",
            "pattern": "\\S"
          }
        }
      }
    }
  }
}
